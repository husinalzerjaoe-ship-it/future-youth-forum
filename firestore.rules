rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isFounder() {
      // Match the same case-insensitive email check used by the Flutter founder UI.
      // Firebase email claims can preserve the casing used by the identity provider.
      return request.auth != null
        && ('email' in request.auth.token)
        && request.auth.token.email is string
        && request.auth.token.email.matches('(?i)^husinalzerjaoe@gmail[.]com$');
    }
    function isChatStaff() {
      return request.auth != null && (isFounder()
        || exists(/databases/$(database)/documents/chatModerators/$(request.auth.uid)));
    }
    function accountNotBanned() {
      let path = /databases/$(database)/documents/userSanctions/$(request.auth.uid);
      return !exists(path)
        || (get(path).data.permanentBan != true
          && (!('banUntil' in get(path).data) || get(path).data.banUntil <= request.time));
    }
    function chatNotMuted() {
      let path = /databases/$(database)/documents/userSanctions/$(request.auth.uid);
      return !exists(path)
        || (get(path).data.permanentMute != true
          && (!('muteUntil' in get(path).data) || get(path).data.muteUntil <= request.time));
    }
    function chatControlEnabled(field) {
      let path = /databases/$(database)/documents/chatControls/main;
      return !exists(path) || get(path).data.get(field, true) == true;
    }
    function messageMediaAllowed(messageType) {
      return messageType in ['text', 'sticker'] || chatControlEnabled('allowMedia');
    }
    function messageLinksAllowed(messageText) {
      return chatControlEnabled('allowLinks') || !messageText.matches('.*https?://.*');
    }
    function usersNotBlocked(a, b) {
      return !exists(/databases/$(database)/documents/userBlocks/$(a + '_' + b))
        && !exists(/databases/$(database)/documents/userBlocks/$(b + '_' + a));
    }
    function roomNotBanned(roomId) {
      return !exists(/databases/$(database)/documents/regionalChats/$(roomId)/bans/$(request.auth.uid))
        || (get(/databases/$(database)/documents/regionalChats/$(roomId)/bans/$(request.auth.uid)).data.permanent != true
          && get(/databases/$(database)/documents/regionalChats/$(roomId)/bans/$(request.auth.uid)).data.expiresAt <= request.time);
    }
    // Private account data, including email, is visible only to its owner.
    match /users/{userId} {
      allow create, read, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if false;

      match /savedClips/{clipId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && accountNotBanned()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['clipId','authorId','authorName','caption','videoUrl','savedAt'])
          && request.resource.data.clipId == clipId
          && request.resource.data.authorId is string
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 80
          && request.resource.data.caption is string
          && request.resource.data.caption.size() <= 500
          && request.resource.data.videoUrl is string
          && request.resource.data.videoUrl.matches('https://.*')
          && request.resource.data.savedAt == request.time;
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /animeWatchlist/{entryId} {
        allow read, create, delete: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['planned', 'watching', 'watched'];
      }

      // Cinema favourites are private to the signed-in account, just like the anime watchlist.
      match /cinemaFavorites/{filmId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['title', 'year', 'addedAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.year is string
          && request.resource.data.year.size() <= 12
          && request.resource.data.addedAt is timestamp;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Purchased profile cosmetics are account-bound. A purchase must reduce
      // the owner's coin wallet in the same atomic transaction.
      match /styleInventory/{itemId} {
        function stylePrice(id) {
          return {
            'crown': 180, 'star': 120, 'creator': 140, 'friend': 100,
            'legend': 350, 'explorer': 130, 'thinker': 150, 'artist': 130,
            'gamer': 160, 'reader': 110, 'goldframe': 220, 'blueframe': 150,
            'purpleframe': 150, 'roseframe': 150, 'mintframe': 150, 'fireframe': 190,
            'spark': 100, 'flame': 120, 'leaf': 90, 'comet': 130, 'diamond': 240,
            'moon': 100, 'oceanbubble': 120, 'violetbubble': 120, 'goldbubble': 180,
            'royalbadge': 200, 'creativebadge': 140, 'friendlybadge': 100
          }[id];
        }
        allow read: if request.auth != null && (request.auth.uid == userId || isFounder());
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['itemId','name','category','price','purchasedAt','grantedBy'])
          && request.resource.data.itemId == itemId
          && request.resource.data.price == stylePrice(itemId)
          && request.resource.data.name is string
          && request.resource.data.category in ['ألقاب','إطارات','زخارف','فقاعات','شارات']
          && request.resource.data.purchasedAt == request.time
          && (
            (isFounder() && request.resource.data.grantedBy == request.auth.uid)
            ||
            (request.auth.uid == userId
              && accountNotBanned()
              && !('grantedBy' in request.resource.data)
              && exists(/databases/$(database)/documents/coinWallets/$(userId))
              && getAfter(/databases/$(database)/documents/coinWallets/$(userId)).data.coins
                == get(/databases/$(database)/documents/coinWallets/$(userId)).data.coins - stylePrice(itemId))
          );
        allow update, delete: if false;
      }
    }

    match /animeWallpapers/{wallpaperId} {
      allow read: if request.auth != null
        && (resource.data.status == 'approved'
          || resource.data.uploaderId == request.auth.uid
          || isFounder());
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.uploaderId == request.auth.uid
        && (
          (request.resource.data.get('category', '') == 'music'
            && request.resource.data.status == 'approved'
            && request.resource.data.extension in ['mp3','m4a','aac','wav','ogg','flac'])
          || (request.resource.data.get('category', '') != 'music'
            && request.resource.data.status == 'pending')
        )
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.anime is string
        && request.resource.data.anime.size() <= 80
        && request.resource.data.artist is string
        && request.resource.data.artist.size() > 0
        && request.resource.data.artist.size() <= 100
        && (!('sourceUrl' in request.resource.data)
          || request.resource.data.sourceUrl == ''
          || (request.resource.data.sourceUrl is string
            && request.resource.data.sourceUrl.matches('https://.*')))
        && request.resource.data.rights in [
          'أنا صاحب العمل وأسمح بنشره',
          'ترخيص Creative Commons يسمح بإعادة الاستخدام',
          'إذن مكتوب من صاحب الحقوق',
          'مصدر رسمي يسمح صراحة بإعادة الاستخدام'
        ]
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.matches('https://.*');
      allow update: if isFounder()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if isFounder()
        || (request.auth != null && resource.data.uploaderId == request.auth.uid && resource.data.status == 'pending');
    }

    // Public profile fields only: display name, biography and photo URL.

    match /users/{userId}/savedPosts/{postId} {
      allow read, create, delete: if request.auth != null
        && request.auth.uid == userId;
      allow update: if false;
    }

    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'bio', 'photoUrl', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() <= 2048;
      allow update: if (
        request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'photoUrl'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() <= 2048
      ) || (
        request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'customTitle', 'customTitleColor', 'customTitleEndColor', 'customTitleFont',
          'customTitleGradient', 'customTitleGlow', 'customTitleIcon',
          'customTitleExpiresAt', 'customTitleUpdatedAt', 'activeStoreTitleIds',
          'profileFrameId', 'profileFrameColor', 'profileDecoration', 'profileDecorationColor'
        ])
        && request.resource.data.get('customTitle', '') is string
        && request.resource.data.get('customTitle', '').size() <= 32
        && request.resource.data.get('customTitleColor', 0) is int
        && request.resource.data.get('customTitleColor', 0) >= 0
        && request.resource.data.get('customTitleColor', 0) <= 4294967295
        && request.resource.data.get('customTitleEndColor', 0) is int
        && request.resource.data.get('customTitleEndColor', 0) >= 0
        && request.resource.data.get('customTitleEndColor', 0) <= 4294967295
        && request.resource.data.get('customTitleFont', 'default') in ['default', 'serif', 'mono']
        && request.resource.data.get('customTitleGradient', false) is bool
        && request.resource.data.get('customTitleGlow', false) is bool
        && request.resource.data.get('customTitleIcon', '') is string
        && request.resource.data.get('customTitleIcon', '').size() <= 4
        && (request.resource.data.get('customTitleExpiresAt', null) == null
          || request.resource.data.get('customTitleExpiresAt', null) is timestamp)
        && request.resource.data.customTitleUpdatedAt == request.time
        && request.resource.data.get('activeStoreTitleIds', []) is list
        && request.resource.data.get('activeStoreTitleIds', []).size() <= 12
        && request.resource.data.get('profileFrameId', '') is string
        && request.resource.data.get('profileFrameId', '').size() <= 40
        && request.resource.data.get('profileFrameColor', 0) is int
        && request.resource.data.get('profileFrameColor', 0) >= 0
        && request.resource.data.get('profileFrameColor', 0) <= 4294967295
        && request.resource.data.get('profileDecoration', '') is string
        && request.resource.data.get('profileDecoration', '').size() <= 40
        && request.resource.data.get('profileDecorationColor', 0) is int
        && request.resource.data.get('profileDecorationColor', 0) >= 0
        && request.resource.data.get('profileDecorationColor', 0) <= 4294967295
      ) || (
        isFounder()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'customTitle', 'customTitleColor', 'customTitleEndColor', 'customTitleFont',
          'customTitleGradient', 'customTitleGlow', 'customTitleIcon',
          'customTitleExpiresAt', 'customTitleUpdatedAt'
        ])
        && request.resource.data.customTitle is string
        && request.resource.data.customTitle.size() <= 32
        && request.resource.data.customTitleColor is int
        && request.resource.data.customTitleColor >= 0
        && request.resource.data.customTitleColor <= 4294967295
        && request.resource.data.customTitleEndColor is int
        && request.resource.data.customTitleEndColor >= 0
        && request.resource.data.customTitleEndColor <= 4294967295
        && request.resource.data.customTitleFont in ['default', 'serif', 'mono']
        && request.resource.data.customTitleGradient is bool
        && request.resource.data.customTitleGlow is bool
        && request.resource.data.customTitleIcon is string
        && request.resource.data.customTitleIcon.size() <= 4
        && (request.resource.data.customTitleExpiresAt == null
          || request.resource.data.customTitleExpiresAt is timestamp)
        && request.resource.data.customTitleUpdatedAt == request.time
      );
      allow delete: if false;

      match /followers/{followerId} {
        allow read: if request.auth != null;
        // A follower record can only be created for the signed-in member,
        // with the exact fields written by the V53/V54 follow transaction.
        allow create: if request.auth != null && accountNotBanned()
          && request.auth.uid == followerId
          && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
          && request.resource.data.userId == followerId
          && request.resource.data.createdAt == request.time;
        allow delete: if request.auth != null && request.auth.uid == followerId;
        allow update: if false;
      }

      match /following/{followedId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && accountNotBanned()
          && request.auth.uid == userId
          && followedId != userId
          && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
          && request.resource.data.userId == followedId
          && request.resource.data.createdAt == request.time;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }

      match /ratings/{raterId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == raterId
          && raterId != userId
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1
          && request.resource.data.stars <= 5;
        allow delete: if false;
      }
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000;
      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'videoUrl']);
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isFounder());

      match /likes/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        // A comment may be text-only or an uploaded voice note. Both remain
        // owned by the authenticated author and subject to account sanctions.
        allow create: if request.auth != null && accountNotBanned()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 60
          && (
            (request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 500)
            || (
              request.resource.data.text == ''
              && request.resource.data.mediaType == 'audio'
              && request.resource.data.audioUrl is string
              && request.resource.data.audioUrl.matches('https://.*')
              && request.resource.data.audioUrl.size() <= 2048
              && (!('durationSeconds' in request.resource.data)
                || (request.resource.data.durationSeconds is int
                  && request.resource.data.durationSeconds >= 1
                  && request.resource.data.durationSeconds <= 180))
            )
            || (
              request.resource.data.text == ''
              && request.resource.data.mediaType in ['image', 'gif']
              && request.resource.data.mediaUrl is string
              && request.resource.data.mediaUrl.matches('https://.*')
              && request.resource.data.mediaUrl.size() <= 2048
            )
          );
        allow update: if request.auth != null
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']);
        allow delete: if request.auth != null
          && resource.data.authorId == request.auth.uid;
      }
    }

    match /watchRooms/{roomId} {
      // Rooms created by older app versions have no visibility/invitedUids fields;
      // treat those legacy rooms as public so the existing group player keeps working.
      function canAccessRoom() {
        let room = get(/databases/$(database)/documents/watchRooms/$(roomId)).data;
        return request.auth != null && (
          !('visibility' in room) || room.visibility != 'private'
          || room.hostUid == request.auth.uid
          || (room.invitedUids is list && request.auth.uid in room.invitedUids)
        );
      }
      // Use the queried document's own fields for top-level room reads.
      // Firestore queries are not filters: a get() of the same document here
      // prevents public/invited room queries from proving their read access.
      // Keep canAccessRoom() below for nested collections, where the parent
      // room must be loaded explicitly.
      allow read: if request.auth != null && (
        !('visibility' in resource.data) || resource.data.visibility != 'private'
        || resource.data.hostUid == request.auth.uid
        || (resource.data.invitedUids is list && request.auth.uid in resource.data.invitedUids)
      );
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.url is string
        && request.resource.data.sourceType in ['youtube', 'direct', 'web']
        && request.resource.data.status == 'paused'
        && request.resource.data.active == true
        && request.resource.data.roomCode is string
        && request.resource.data.roomCode.matches('^[0-9]{6}$')
        && (!('roomType' in request.resource.data) || request.resource.data.roomType in ['watch', 'cinema'])
        && (!('passwordProtected' in request.resource.data) || request.resource.data.passwordProtected is bool)
        && (!('passwordProtected' in request.resource.data) || request.resource.data.passwordProtected != true
          || (request.resource.data.visibility == 'private'
            && request.resource.data.passwordSalt is string
            && request.resource.data.passwordSalt.size() >= 16
            && request.resource.data.passwordHash is string
            && request.resource.data.passwordHash.size() == 64))
        && (!('visibility' in request.resource.data) || request.resource.data.visibility in ['public', 'private'])
        && (!('invitedUids' in request.resource.data) || (request.resource.data.invitedUids is list && request.resource.data.invitedUids.size() <= 50))
        && (!('visibility' in request.resource.data) || request.resource.data.visibility != 'private'
          || (request.resource.data.invitedUids is list
            && (request.auth.uid in request.resource.data.invitedUids || request.resource.data.invitedUids.size() == 0)));
      // The host retains room-management control. Any authorized room participant
      // may send playback commands only; they cannot change the video, invitations,
      // host, visibility, or room lifecycle.
      allow update: if request.auth != null
        && request.resource.data.hostUid == resource.data.hostUid
        && (
          (isFounder() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'status']) && request.resource.data.active == false && request.resource.data.status == 'paused')
          ||
          (resource.data.hostUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'positionSeconds', 'updatedAt', 'active', 'url', 'sourceType', 'videoId', 'controlUid']))
          ||
          (canAccessRoom()
            && accountNotBanned()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'positionSeconds', 'updatedAt', 'controlUid'])
            && request.resource.data.controlUid == request.auth.uid
            && request.resource.data.status in ['playing', 'paused']
            && request.resource.data.positionSeconds is number
            && request.resource.data.positionSeconds >= 0
            && request.resource.data.positionSeconds <= 86400
            && request.resource.data.updatedAt is timestamp)
        );
      allow delete: if request.auth != null && (resource.data.hostUid == request.auth.uid || isFounder());
      match /participants/{userId} {
        allow read: if canAccessRoom();
        allow create, update: if canAccessRoom() && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 60
          && request.resource.data.photoUrl is string;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      function roomChatNotMuted() {
        let mutePath = /databases/$(database)/documents/watchRooms/$(roomId)/roomMutes/$(request.auth.uid);
        return !exists(mutePath) || (get(mutePath).data.permanent != true && (!('until' in get(mutePath).data) || get(mutePath).data.until <= request.time));
      }
      match /roomMutes/{userId} {
        allow read: if canAccessRoom();
        allow create, update: if request.auth != null && (isFounder() || get(/databases/$(database)/documents/watchRooms/$(roomId)).data.hostUid == request.auth.uid)
          && request.resource.data.uid == userId && request.resource.data.by == request.auth.uid && request.resource.data.permanent is bool;
        allow delete: if request.auth != null && (isFounder() || get(/databases/$(database)/documents/watchRooms/$(roomId)).data.hostUid == request.auth.uid);
      }
      // Watch-room chat supports text, images and voice.
      match /messages/{messageId} {
        allow read: if canAccessRoom();
        allow create: if canAccessRoom()
          && request.auth != null
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 60
          && roomChatNotMuted() && accountNotBanned() && chatNotMuted()
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && request.resource.data.type in ['text', 'image', 'voice', 'video', 'gif', 'sticker']
          && (!('replyTo' in request.resource.data) || request.resource.data.replyTo is map)
          && ((request.resource.data.type == 'text' && request.resource.data.text.size() > 0)
            || (request.resource.data.type == 'image' && request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.matches('https://.*'))
            || (request.resource.data.type == 'voice' && request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.matches('https://.*') && request.resource.data.durationSeconds is int && request.resource.data.durationSeconds >= 1 && request.resource.data.durationSeconds <= 180)
            || (request.resource.data.type == 'video' && request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.matches('https://.*'))
            || (request.resource.data.type == 'gif' && request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.matches('https://.*'))
            || (request.resource.data.type == 'sticker' && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 16));
        allow update: if false;
        allow delete: if canAccessRoom()
          && request.auth != null
          && (resource.data.senderUid == request.auth.uid || isChatStaff());
      }
    }

    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 300
        && request.resource.data.status == 'new';
      allow read: if isChatStaff();
      allow update: if isChatStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status == 'reviewed'
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if isFounder();
    }

    // Public chat: users may edit/delete their own messages; founder/moderators can pin and moderate.
    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned() && chatNotMuted()
        && chatControlEnabled('publicChatEnabled')
        && messageMediaAllowed(request.resource.data.type)
        && messageLinksAllowed(request.resource.data.text)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderRole == (isFounder() ? 'founder' : 'member')
        && request.resource.data.type in ['text', 'image', 'sticker', 'voice', 'video', 'gif']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && (
          (request.resource.data.type == 'text' && request.resource.data.text.size() > 0)
          || (request.resource.data.type == 'sticker' && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 16)
          || (request.resource.data.type == 'gif'
            && ((request.resource.data.get('gifUrl', '') is string && request.resource.data.get('gifUrl', '').matches('https://.*'))
              || (request.resource.data.get('imageUrl', '') is string && request.resource.data.get('imageUrl', '').matches('https://.*'))))
          || (request.resource.data.type == 'image'
            && request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.matches('https://.*'))
          || (request.resource.data.type == 'voice'
            && request.resource.data.audioUrl is string
            && request.resource.data.audioUrl.matches('https://.*')
            && request.resource.data.durationSeconds is int
            && request.resource.data.durationSeconds >= 1
            && request.resource.data.durationSeconds <= 180)
          || (request.resource.data.type == 'video'
            && request.resource.data.videoUrl is string
            && request.resource.data.videoUrl.matches('https://.*'))
        )
        && (!('replyTo' in request.resource.data) || request.resource.data.replyTo is map);
      allow update: if request.auth != null && (
        (resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000)
        || (isChatStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinned', 'pinnedBy'])
          && request.resource.data.pinnedBy == request.auth.uid
          && request.resource.data.isPinned is bool)
      );
      allow delete: if request.auth != null
        && (resource.data.senderId == request.auth.uid || isChatStaff());

      match /reactions/{userId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.emoji in ['❤️', '😂', '🔥', '👏', '😍', '🥹', '💜', '🎉'];
        allow delete: if request.auth != null
          && (request.auth.uid == userId || isChatStaff());
      }
    }

    match /chatPresence/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.online is bool;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /chatTyping/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.typing is bool;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /chatPreferences/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['background', 'updatedAt'])
        && request.resource.data.background is int;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Only the founder can grant/revoke paid or complimentary memberships.
    match /memberships/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isFounder()
        && request.resource.data.uid == userId
        && request.resource.data.tier in ['premium', 'silver', 'gold', 'diamond']
        && request.resource.data.expiresAt is timestamp;
      allow delete: if isFounder();
    }

    // Founder-controlled points. Members can read only their own balance.
    match /pointBalances/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isFounder());
      allow create, update: if isFounder()
        && request.resource.data.uid == userId
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isFounder();
    }

    match /pointGrants/{grantId} {
      allow read: if isFounder()
        || (request.auth != null && resource.data.targetUid == request.auth.uid);
      allow create: if isFounder()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /chatModerators/{userId} {
      allow read: if isFounder() || (request.auth != null && request.auth.uid == userId);
      allow create, update: if isFounder()
        && request.resource.data.uid == userId
        && request.resource.data.grantedBy == request.auth.uid;
      allow delete: if isFounder();
    }

    // Central moderation records. Only the founder or assigned moderators can change sanctions.
    match /userSanctions/{userId} {
      allow read: if isChatStaff() || (request.auth != null && request.auth.uid == userId);
      allow create, update: if isChatStaff()
        && request.resource.data.uid == userId
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isFounder();
    }

    // Append-only audit trail; client cannot edit or erase historical actions.
    match /adminLogs/{logId} {
      allow read: if isChatStaff();
      allow create: if isChatStaff()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.action is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /weeklyContests/{contestId} {
      allow read: if request.auth != null;
      allow create: if isFounder()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.status == 'open'
        && request.resource.data.endsAt is timestamp;
      allow update: if isFounder()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'winnerUid', 'winnerChosenAt']);
      allow delete: if isFounder();

      match /entries/{userId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isFounder());
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && get(/databases/$(database)/documents/weeklyContests/$(contestId)).data.status == 'open'
          && get(/databases/$(database)/documents/weeklyContests/$(contestId)).data.endsAt > request.time;
        allow update: if false;
        allow delete: if request.auth != null && (request.auth.uid == userId || isFounder());
      }
    }

    match /poems/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 3000;
      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']);
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    match /quotes/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 3000;
      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']);
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    match /mediaLinks/{linkId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.url is string
        && request.resource.data.url.matches('https://(www\\.|m\\.|music\\.)?youtube\\.com/.*|https://(www\\.)?youtu\\.be/.*|https://(www\\.)?youtube-nocookie\\.com/.*')
        && request.resource.data.category in ['أغاني', 'فيديوهات', 'أفلام ومقاطع رسمية', 'تعليم', 'متنوع'];
      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'url', 'category'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.url is string
        && request.resource.data.url.matches('https://(www\\.|m\\.)?youtube\\.com/.*|https://(www\\.)?youtu\\.be/.*')
        && request.resource.data.category in ['أغاني', 'فيديوهات', 'أفلام ومقاطع رسمية', 'تعليم', 'متنوع'];
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.matches('https://.*')
        && request.resource.data.mediaType in ['image', 'video']
        // Stories may expire after 24 hours or remain until their owner deletes them.
        && (request.resource.data.expiresAt == null
          || (request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt > request.time
            && request.resource.data.expiresAt <= request.time + duration.value(24, 'h')));
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;

      match /views/{viewerId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == viewerId
          && request.resource.data.viewerId == request.auth.uid;
        allow delete: if request.auth != null && request.auth.uid == viewerId;
      }

      match /replies/{replyId} {
        allow read: if request.auth != null;
        // Story replies support text and voice notes; media URLs must be HTTPS.
        allow create: if request.auth != null && accountNotBanned()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorId is string
          && request.resource.data.authorId.size() > 0
          && (
            (request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 300)
            || (
              request.resource.data.text == ''
              && request.resource.data.mediaType == 'audio'
              && request.resource.data.audioUrl is string
              && request.resource.data.audioUrl.matches('https://.*')
              && request.resource.data.audioUrl.size() <= 2048
              && (!('durationSeconds' in request.resource.data)
                || (request.resource.data.durationSeconds is int
                  && request.resource.data.durationSeconds >= 1
                  && request.resource.data.durationSeconds <= 180))
            )
          );
        allow update: if request.auth != null
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']);
        allow delete: if request.auth != null
          && (resource.data.authorId == request.auth.uid || isChatStaff());
      }
    }

    // Permanent vertical community clips support video, still images and animated GIFs.
    match /communityClips/{clipId} {
      allow read: if request.auth != null && accountNotBanned();
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 500
        && request.resource.data.createdAt is timestamp
        && (
          ((!('mediaType' in request.resource.data) || request.resource.data.mediaType == 'video')
            && request.resource.data.videoUrl is string
            && request.resource.data.videoUrl.matches('https://.*'))
          || (request.resource.data.mediaType in ['image', 'gif']
            && request.resource.data.mediaUrl is string
            && request.resource.data.mediaUrl.matches('https://.*'))
        );
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isChatStaff());

      match /likes/{likeId} {
        allow read: if request.auth != null && accountNotBanned();
        allow create, update: if request.auth != null && accountNotBanned()
          && request.auth.uid == likeId
          && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null && request.auth.uid == likeId;
      }

      match /views/{viewerId} {
        allow read: if request.auth != null && accountNotBanned();
        allow create: if request.auth != null && accountNotBanned()
          && request.auth.uid == viewerId
          && request.resource.data.viewerId == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == viewerId;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null && accountNotBanned();
        allow create: if request.auth != null && accountNotBanned()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.createdAt is timestamp
          && (
            (request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 300)
            || (request.resource.data.text == ''
              && request.resource.data.mediaType == 'audio'
              && request.resource.data.audioUrl is string
              && request.resource.data.audioUrl.matches('https://.*')
              && request.resource.data.audioUrl.size() <= 2048
              && request.resource.data.durationSeconds is int
              && request.resource.data.durationSeconds >= 1
              && request.resource.data.durationSeconds <= 180)
            || (request.resource.data.text == ''
              && request.resource.data.mediaType in ['image', 'gif']
              && request.resource.data.mediaUrl is string
              && request.resource.data.mediaUrl.matches('https://.*')
              && request.resource.data.mediaUrl.size() <= 2048)
          );
        allow update: if request.auth != null
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300;
        allow delete: if request.auth != null
          && (resource.data.authorId == request.auth.uid || isChatStaff());
      }
    }

    match /regionalChats/{roomId}/bans/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isFounder());
      // Founder and assigned chat moderators can manage regional-room bans.
      allow create, update: if isChatStaff()
        && request.resource.data.permanent is bool
        && request.resource.data.by == request.auth.uid
        && (request.resource.data.permanent == true
          ? request.resource.data.expiresAt == null
          : request.resource.data.expiresAt is timestamp);
      allow delete: if isChatStaff();
    }

    match /regionalChats/{roomId}/messages/{messageId} {
      allow read: if request.auth != null && roomNotBanned(roomId);
      allow create: if request.auth != null && accountNotBanned() && chatNotMuted() && roomNotBanned(roomId)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderRole == (isFounder() ? 'founder' : 'member')
        && request.resource.data.type in ['text', 'image', 'sticker', 'voice', 'video']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && (
          (request.resource.data.type == 'text' && request.resource.data.text.size() > 0)
          || (request.resource.data.type == 'sticker' && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 16)
          || (request.resource.data.type == 'image'
            && request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.matches('https://.*'))
          || (request.resource.data.type == 'voice'
            && request.resource.data.audioUrl is string
            && request.resource.data.audioUrl.matches('https://.*')
            && request.resource.data.durationSeconds is int
            && request.resource.data.durationSeconds >= 1
            && request.resource.data.durationSeconds <= 180)
          || (request.resource.data.type == 'video'
            && request.resource.data.videoUrl is string
            && request.resource.data.videoUrl.matches('https://.*'))
        );
      // Keep regional-room moderation consistent with the public chat staff role.
      allow update, delete: if isChatStaff();
    }

    match /userBlocks/{blockId} {
      // A user may check their own deterministic block document even when it does not exist yet.
      allow get: if request.auth != null
        && (resource == null || resource.data.blockerId == request.auth.uid);
      allow list: if request.auth != null
        && resource.data.blockerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId is string
        && request.resource.data.blockedId != request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.blockedId;
      allow delete: if request.auth != null && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    match /conversations/{conversationId} {
      function otherConversationMember() {
        return resource.data.members[0] == request.auth.uid
          ? resource.data.members[1]
          : resource.data.members[0];
      }
      // Per-user pin/mute state is stored on the conversation for efficient inbox sorting.
      // A member may change only their own entry, never the other participant's.
      function selfOnlyMemberFlag(field) {
        let oldValues = resource.data.get(field, []);
        let newValues = request.resource.data.get(field, []);
        let otherUid = otherConversationMember();
        return oldValues is list && newValues is list
          && newValues.size() <= 2
          && ((otherUid in oldValues) == (otherUid in newValues));
      }
      // The current inbox query is an OR over memberA/memberB. Keep list
      // authorization aligned with those exact query predicates so Firestore
      // can prove every returned conversation belongs to the signed-in user.
      // get() still supports legacy documents whose membership is stored only
      // in the members array; a missing deterministic DM may be checked safely.
      allow get: if request.auth != null && (
        resource == null
        || (resource.data.members is list && request.auth.uid in resource.data.members)
        || resource.data.memberA == request.auth.uid
        || resource.data.memberB == request.auth.uid
      );
      allow list: if request.auth != null
        && (resource.data.memberA == request.auth.uid
          || resource.data.memberB == request.auth.uid);
      allow create: if request.auth != null && accountNotBanned()
        && chatControlEnabled('directMessagesEnabled')
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] is string
        && request.resource.data.members[1] is string
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && usersNotBlocked(request.resource.data.members[0], request.resource.data.members[1]);
      allow update: if request.auth != null && accountNotBanned() && chatNotMuted()
        && chatControlEnabled('directMessagesEnabled')
        && request.auth.uid in resource.data.members
        && resource.data.members is list
        && resource.data.members.size() == 2
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        // Allow only reordering of the same two members for legacy DMs.
        && request.resource.data.members.hasAll(resource.data.members)
        // Explicit inbox indexes must always mirror the canonical two-member array.
        && (!('memberA' in request.resource.data) || request.resource.data.memberA == request.resource.data.members[0])
        && (!('memberB' in request.resource.data) || request.resource.data.memberB == request.resource.data.members[1])
        && resource.data.members.hasAll(request.resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberA', 'memberB', 'lastMessage', 'updatedAt', 'memberNames', 'backgrounds', 'pinnedBy', 'mutedBy'])
        && (!('backgrounds' in request.resource.data) || request.resource.data.backgrounds is map)
        && selfOnlyMemberFlag('pinnedBy')
        && selfOnlyMemberFlag('mutedBy')
        && usersNotBlocked(resource.data.members[0], resource.data.members[1]);
      allow delete: if false;

      match /messages/{messageId} {
        function isMember() {
          let parent = get(/databases/$(database)/documents/conversations/$(conversationId));
          return parent.data.members is list
            && request.auth.uid in parent.data.members;
        }
        function members() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        }
        allow read: if request.auth != null && isMember();
        allow create: if request.auth != null && accountNotBanned() && chatNotMuted()
          && chatControlEnabled('directMessagesEnabled')
          && messageMediaAllowed(request.resource.data.type)
          && messageLinksAllowed(request.resource.data.text)
          && isMember()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole == (isFounder() ? 'founder' : 'member')
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && (
            (request.resource.data.type == 'text' && request.resource.data.text.size() > 0)
            || (request.resource.data.type == 'sticker'
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 16)
            || (request.resource.data.type == 'gif'
              && request.resource.data.gifUrl is string
              && request.resource.data.gifUrl.matches('https://.*'))
            || (request.resource.data.type == 'image'
              && request.resource.data.imageUrl is string
              && request.resource.data.imageUrl.matches('https://.*'))
            || (request.resource.data.type == 'voice'
              && request.resource.data.audioUrl is string
              && request.resource.data.audioUrl.matches('https://.*')
              && request.resource.data.durationSeconds is int
              && request.resource.data.durationSeconds >= 1
              && request.resource.data.durationSeconds <= 180)
            || (request.resource.data.type == 'video'
              && request.resource.data.videoUrl is string
              && request.resource.data.videoUrl.matches('https://.*'))
          )
          && usersNotBlocked(members()[0], members()[1]);
        // A sender may edit only their own plain-text message; all media payloads stay immutable.
        // Either participant may pin a message, but only the member who pinned it may unpin it.
        allow update: if request.auth != null && isMember() && (
          (
            resource.data.senderId == request.auth.uid
            && resource.data.type == 'text'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'editedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 1000
            && request.resource.data.edited == true
            && request.resource.data.editedAt is timestamp
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinned', 'pinnedBy', 'pinnedAt'])
            && request.resource.data.isPinned is bool
            && (
              (request.resource.data.isPinned == true
                && request.resource.data.pinnedBy == request.auth.uid
                && request.resource.data.pinnedAt is timestamp)
              || (request.resource.data.isPinned == false
                && resource.data.pinnedBy == request.auth.uid
                && !('pinnedBy' in request.resource.data)
                && !('pinnedAt' in request.resource.data))
            )
          )
        );
        allow delete: if request.auth != null && isMember()
          && resource.data.senderId == request.auth.uid;

        match /reactions/{userId} {
          allow read: if request.auth != null && request.auth.uid in members();
          allow create, update: if request.auth != null
            && request.auth.uid == userId
            && request.auth.uid in members()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.emoji in ['❤️', '😂', '🔥', '👏', '😍', '😢']
            && usersNotBlocked(members()[0], members()[1]);
          allow delete: if request.auth != null
            && request.auth.uid == userId
            && request.auth.uid in members();
        }
      }

      // Conversation-only typing status; only the two members can observe it.
      match /typing/{userId} {
        function isConversationMember() {
          let parent = get(/databases/$(database)/documents/conversations/$(conversationId));
          return request.auth != null
            && parent.data.members is list
            && request.auth.uid in parent.data.members;
        }
        allow read: if isConversationMember();
        allow create, update: if isConversationMember()
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.typing is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if isConversationMember() && request.auth.uid == userId;
      }

      // Each participant writes only their own read cursor.
      match /readReceipts/{userId} {
        function isConversationMember() {
          let parent = get(/databases/$(database)/documents/conversations/$(conversationId));
          return request.auth != null
            && parent.data.members is list
            && request.auth.uid in parent.data.members;
        }
        allow read: if isConversationMember();
        allow create, update: if isConversationMember()
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.lastReadMessageId is string
          && request.resource.data.lastReadMessageId.size() <= 128
          && request.resource.data.lastReadAt == request.time;
        allow delete: if isConversationMember() && request.auth.uid == userId;
      }
    }

    // Forum announcements are readable by signed-in members and writable only by the founder.
    match /forumAnnouncements/{announcementId} {
      allow read: if request.auth != null;
      allow create: if isFounder()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.author == 'Alfredo';
      allow update: if isFounder()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body']);
      allow delete: if isFounder();
    }

    match /gameInvites/{inviteId} {
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.game in ['general', 'football', 'player', 'speed', 'xo', 'treasure', 'arcade_ludo', 'arcade_jackaroo', 'arcade_chess', 'arcade_mafia', 'arcade_racing', 'arcade_snake', 'arcade_space', 'arcade_platform', 'arcade_tower', 'arcade_fishing', 'arcade_millionaire', 'arcade_sudoku', 'arcade_wordsearch', 'arcade_bomb']
        && (
          (request.resource.data.game in ['general', 'player', 'speed'])
          || (request.resource.data.game == 'football'
            && !('roomId' in request.resource.data))
          || (request.resource.data.game == 'xo'
            && request.resource.data.roomId is string
            && exists(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId))
            && get(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId)).data.hostId == request.auth.uid
            && get(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId)).data.game == 'xo'
            && get(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId)).data.status == 'waiting'
            && !(request.resource.data.to in get(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId)).data.members))
          || (request.resource.data.game == 'football'
            && request.resource.data.roomId is string
            && exists(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId))
            && get(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId)).data.hostId == request.auth.uid
            && get(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId)).data.game == 'football_quiz'
            && get(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId)).data.status == 'waiting'
            && !(request.resource.data.to in get(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId)).data.members))
          || (request.resource.data.game == 'treasure'
            && request.resource.data.roomId is string
            && exists(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId))
            && get(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId)).data.hostId == request.auth.uid
            && get(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId)).data.game == 'treasure_duel'
            && get(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId)).data.status == 'waiting'
            && !(request.resource.data.to in get(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId)).data.members))
          || (request.resource.data.game in ['arcade_ludo', 'arcade_jackaroo', 'arcade_chess', 'arcade_mafia', 'arcade_racing', 'arcade_snake', 'arcade_space', 'arcade_platform', 'arcade_tower', 'arcade_fishing', 'arcade_millionaire', 'arcade_sudoku', 'arcade_wordsearch', 'arcade_bomb']
            && request.resource.data.roomId is string
            && exists(/databases/$(database)/documents/arcadeRooms/$(request.resource.data.roomId))
            && get(/databases/$(database)/documents/arcadeRooms/$(request.resource.data.roomId)).data.hostId == request.auth.uid
            && get(/databases/$(database)/documents/arcadeRooms/$(request.resource.data.roomId)).data.gameId == request.resource.data.game
            && get(/databases/$(database)/documents/arcadeRooms/$(request.resource.data.roomId)).data.status == 'waiting'
            && !(request.resource.data.to in get(/databases/$(database)/documents/arcadeRooms/$(request.resource.data.roomId)).data.members))
        );
      allow read: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow update: if request.auth != null
        && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /notifications/{notificationId} {
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId.size() > 0
        && request.resource.data.recipientId != request.auth.uid
        && exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.recipientId))
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() <= 60
        && request.resource.data.type in ['follow', 'like', 'comment', 'message', 'story_reply', 'mention']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 180
        && request.resource.data.read == false;
      allow read: if request.auth != null && resource.data.recipientId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if false;
    }
    // Community polls: one immutable vote per signed-in member.
    match /communityPolls/{pollId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.question is string
        && request.resource.data.question.size() >= 5
        && request.resource.data.question.size() <= 160
        && request.resource.data.options is list
        && request.resource.data.options.size() >= 2
        && request.resource.data.options.size() <= 5
        && request.resource.data.options[0] is string
        && request.resource.data.options[1] is string
        && (request.resource.data.options.size() < 3 || request.resource.data.options[2] is string)
        && (request.resource.data.options.size() < 4 || request.resource.data.options[3] is string)
        && (request.resource.data.options.size() < 5 || request.resource.data.options[4] is string)
        && request.resource.data.active == true;
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.createdBy == request.auth.uid || isChatStaff());

      match /votes/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && accountNotBanned()
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.option is int
          && request.resource.data.option >= 0
          && request.resource.data.option < get(/databases/$(database)/documents/communityPolls/$(pollId)).data.options.size()
          && get(/databases/$(database)/documents/communityPolls/$(pollId)).data.active == true;
        allow update: if false;
        allow delete: if request.auth != null
          && (request.auth.uid == userId
            || isChatStaff()
            || get(/databases/$(database)/documents/communityPolls/$(pollId)).data.createdBy == request.auth.uid);
      }
    }

    // Founder-managed community events with member RSVP records.
    // Community events: preserve founder-managed RSVP subcollection and member-created attendee-list events.
    match /communityEvents/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned() && (
        (isFounder()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 100
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.description.size() <= 700
          && request.resource.data.startsAt is timestamp
          && request.resource.data.startsAt > request.time)
        ||
        (request.resource.data.createdBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 80
          && request.resource.data.details is string
          && request.resource.data.details.size() <= 500
          && request.resource.data.startsAt is timestamp
          && request.resource.data.attendees is list
          && request.resource.data.attendees.size() == 1
          && request.auth.uid in request.resource.data.attendees)
      );
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees'])
        && request.resource.data.attendees is list
        && request.resource.data.attendees.size() <= 500
        && (
          (!(request.auth.uid in resource.data.attendees)
            && request.auth.uid in request.resource.data.attendees
            && request.resource.data.attendees.hasAll(resource.data.attendees)
            && request.resource.data.attendees.size() == resource.data.attendees.size() + 1)
          || (request.auth.uid in resource.data.attendees
            && !(request.auth.uid in request.resource.data.attendees)
            && resource.data.attendees.hasAll(request.resource.data.attendees)
            && resource.data.attendees.size() == request.resource.data.attendees.size() + 1)
        );
      allow delete: if request.auth != null
        && (resource.data.createdBy == request.auth.uid || isFounder());

      match /attendees/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && accountNotBanned()
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 60
          && get(/databases/$(database)/documents/communityEvents/$(eventId)).data.startsAt > request.time;
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    } 

    // Invite-only rooms: only the owner and explicitly invited member UIDs can read.
    match /privateRooms/{roomId}/access/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId
        && request.auth.uid in get(/databases/$(database)/documents/privateRooms/$(roomId)).data.members;
      // Legacy access records are retained for compatibility; invited membership is sufficient.
      allow create, update, delete: if false;
    }

    match /privateRooms/{roomId} {
      allow read: if request.auth != null
        && resource.data.members is list
        && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 60
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 1
        && request.resource.data.members.size() <= 30
        && request.auth.uid in request.resource.data.members
        && request.resource.data.invitedUids == request.resource.data.members
        && (!('roomType' in request.resource.data)
          || request.resource.data.roomType in ['text', 'voice'])
        && (!('roomType' in request.resource.data)
          || request.resource.data.roomType != 'voice'
          || (request.resource.data.meetUrl is string
            && request.resource.data.meetUrl.matches('https://meet\\.google\\.com/.*')));
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt'])
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() <= 200)
          ||
          (request.auth.uid == resource.data.ownerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','invitedUids','roomAdmins'])
            && request.resource.data.members is list
            && request.resource.data.members.size() >= 1
            && request.resource.data.members.size() <= 30
            && request.auth.uid in request.resource.data.members
            && request.resource.data.invitedUids == request.resource.data.members
            && request.resource.data.roomAdmins is list
            && request.resource.data.members.hasAll(request.resource.data.roomAdmins))
        );
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      match /messages/{messageId} {
        function roomMembers() {
          return get(/databases/$(database)/documents/privateRooms/$(roomId)).data.members;
        }
        allow read: if request.auth != null && request.auth.uid in roomMembers();
        allow create: if request.auth != null && accountNotBanned()
          && request.auth.uid in roomMembers()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (
            (request.resource.data.type == 'text' && request.resource.data.text.size() > 0)
            || (request.resource.data.type == 'image'
              && request.resource.data.imageUrl is string
              && request.resource.data.imageUrl.matches('https://.*'))
            || (request.resource.data.type == 'voice'
              && request.resource.data.audioUrl is string
              && request.resource.data.audioUrl.matches('https://.*')
              && request.resource.data.durationSeconds is int
              && request.resource.data.durationSeconds >= 1
              && request.resource.data.durationSeconds <= 180)
            || (request.resource.data.type == 'video'
              && request.resource.data.videoUrl is string
              && request.resource.data.videoUrl.matches('https://.*'))
          );
        allow update: if false;
        allow delete: if request.auth != null
          && request.auth.uid in roomMembers()
          && (request.auth.uid == get(/databases/$(database)/documents/privateRooms/$(roomId)).data.ownerId
            || resource.data.senderId == request.auth.uid);
      }
    }

    // Files uploaded by members stay private to the uploader until moderation.
    match /sharedFiles/{fileId} {
      allow read: if request.auth != null
        && (resource.data.status == 'approved'
          || resource.data.uploaderId == request.auth.uid
          || isFounder());
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.uploaderId == request.auth.uid
        && (
          (request.resource.data.get('category', '') == 'music'
            && request.resource.data.status == 'approved'
            && request.resource.data.extension in ['mp3','m4a','aac','wav','ogg','flac'])
          || (request.resource.data.get('category', '') != 'music'
            && request.resource.data.status == 'pending')
        )
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.extension in ['apk','xapk','zip','pdf','mp3','m4a','aac','wav','ogg','flac']
        && request.resource.data.fileUrl is string
        && request.resource.data.fileUrl.matches('https://.*')
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 104857600;
      allow update: if isFounder()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if isFounder()
        || (request.auth != null && resource.data.uploaderId == request.auth.uid && resource.data.status == 'pending');
    }



    // Community topics and threaded replies.
    match /communityTopics/{topicId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.category in ['أنمي', 'مانغا', 'ألعاب', 'نقاش عام', 'نظريات وتحليلات']
        && request.resource.data.isLocked == false
        && request.resource.data.replyCount == 0;
      allow update: if request.auth != null && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
          && request.resource.data.replyCount == resource.data.replyCount + 1)
        || (isFounder()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isLocked'])
          && request.resource.data.isLocked is bool)
      );
      allow delete: if isFounder()
        || (request.auth != null && resource.data.authorId == request.auth.uid);
      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && accountNotBanned()
          && get(/databases/$(database)/documents/communityTopics/$(topicId)).data.isLocked == false
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 60
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update: if false;
        allow delete: if request.auth != null
          && (isFounder() || resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/communityTopics/$(topicId)).data.authorId == request.auth.uid);
      }
    }

    // Watch parties: video is opened at the rights holder; chat stays in this app.
    match /watchParties/{partyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 60
        && request.resource.data.match is string
        && request.resource.data.match.size() <= 100
        && request.resource.data.streamUrl is string
        && request.resource.data.streamUrl.matches('https://.*')
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.auth.uid in request.resource.data.members
        && request.resource.data.status == 'open';
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.hostId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','match','streamUrl','status'])
          && request.resource.data.streamUrl is string
          && request.resource.data.streamUrl.matches('https://.*'))
        || (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playbackPlaying','playbackPositionMs','playbackUpdatedAt','playbackUpdatedBy'])
          && request.resource.data.playbackPlaying is bool
          && request.resource.data.playbackPositionMs is int
          && request.resource.data.playbackPositionMs >= 0
          && request.resource.data.playbackPositionMs <= 86400000
          && request.resource.data.playbackUpdatedBy == request.auth.uid)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members is list
          && request.resource.data.members.size() <= 30
          && request.auth.uid in request.resource.data.members
          && (
            (request.auth.uid == resource.data.hostId)
            || (!(request.auth.uid in resource.data.members)
              && request.resource.data.members.hasAll(resource.data.members)
              && request.resource.data.members.size() == resource.data.members.size() + 1)
            || (request.auth.uid in resource.data.members
              && resource.data.members.hasAll(request.resource.data.members)
              && resource.data.members.size() == request.resource.data.members.size() + 1
              && !(request.auth.uid in request.resource.data.members))
          ))
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.hostId;
      match /messages/{messageId} {
        function partyMembers() {
          return get(/databases/$(database)/documents/watchParties/$(partyId)).data.members;
        }
        allow read: if request.auth != null && request.auth.uid in partyMembers();
        allow create: if request.auth != null && accountNotBanned()
          && request.auth.uid in partyMembers()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 60;
        allow update, delete: if false;
      }
    }



    match /communityQuestions/{questionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.anonymous == true
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 700;
      allow update: if false;
      allow delete: if isChatStaff();
    }

    match /interestPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 60
        && request.resource.data.category in ['الأنمي والمانغا','كرة القدم','الشعر والأدب','الألعاب','التقنية','التصوير والفن']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isChatStaff());
    }


    // Realtime multiplayer game rooms. Only room members can read active games.
    match /gameRooms/{roomId} {
      allow read: if request.auth != null
        && (resource.data.status == 'waiting'
          || request.auth.uid in resource.data.members);
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0] == request.auth.uid
        && request.resource.data.status == 'waiting'
        && (
          (request.resource.data.game == 'xo'
            && request.resource.data.board is list
            && request.resource.data.board.size() == 9
            && request.resource.data.turn == request.auth.uid
            && request.resource.data.winner == ''
            && request.resource.data.roomCode is string
            && request.resource.data.roomCode.matches('^[0-9]{6}$'))
          ||
          (request.resource.data.game == 'football_quiz'
            && request.resource.data.round == 0
            && request.resource.data.answers is map
            && request.resource.data.scores is map)
          ||
          (request.resource.data.game == 'treasure_duel'
            && request.resource.data.roomCode is string
            && request.resource.data.roomCode.matches('^[0-9]{6}$')
            && request.resource.data.positions is list
            && request.resource.data.positions.size() == 2
            && request.resource.data.treasures is list
            && request.resource.data.treasures.size() == 6
            && request.resource.data.scores is map
            && request.resource.data.turn == request.auth.uid
            && request.resource.data.winner == ''
            && request.resource.data.moves == 0
            && request.resource.data.scores[request.auth.uid] == 0
            && request.resource.data.memberNames[request.auth.uid] is string)
        );
      allow update: if request.auth != null && (
        // Add a player to a waiting XO or football quiz room.
        (!(request.auth.uid in resource.data.members)
          && resource.data.status == 'waiting'
          && (
            (resource.data.game == 'xo' && resource.data.members.size() == 1
              && request.resource.data.members.size() == 2)
            ||
            (resource.data.game == 'football_quiz' && resource.data.members.size() < 4
              && request.resource.data.members.size() == resource.data.members.size() + 1)
            ||
            (resource.data.game == 'treasure_duel' && resource.data.members.size() == 1
              && request.resource.data.members.size() == 2)
          )
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && (resource.data.game != 'treasure_duel' || (
            request.resource.data.scores[resource.data.hostId] == resource.data.scores[resource.data.hostId]
            && request.resource.data.scores[request.auth.uid] == 0
            && request.resource.data.memberNames[request.auth.uid] is string
          ))
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members', 'memberNames', 'scores', 'status', 'updatedAt'])
          && ((resource.data.game == 'xo' && request.resource.data.status == 'playing')
            || (resource.data.game == 'football_quiz' && request.resource.data.status == 'waiting')
            || (resource.data.game == 'treasure_duel' && request.resource.data.status == 'playing'))
        )
        ||
        // XO moves are synchronized between the two players.
        (resource.data.game == 'xo'
          && request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['board', 'winner', 'turn', 'status', 'updatedAt'])
          && request.resource.data.board is list
          && request.resource.data.board.size() == 9
          && request.resource.data.status in ['playing', 'finished', 'waiting']
          && request.resource.data.winner is string
          && request.resource.data.turn is string)
        ||
        // Secure turn-based 2D treasure duel.
        (resource.data.game == 'treasure_duel'
          && request.auth.uid in resource.data.members
          && resource.data.status == 'playing'
          && resource.data.turn == request.auth.uid
          && request.resource.data.members == resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['positions', 'treasures', 'scores', 'moves', 'turn', 'winner', 'status', 'updatedAt'])
          && request.resource.data.positions is list
          && request.resource.data.positions.size() == 2
          && request.resource.data.positions[0] is int
          && request.resource.data.positions[1] is int
          && request.resource.data.positions[0] >= 0
          && request.resource.data.positions[0] < 49
          && request.resource.data.positions[1] >= 0
          && request.resource.data.positions[1] < 49
          && request.resource.data.positions[0] != request.resource.data.positions[1]
          && request.resource.data.treasures is list
          && request.resource.data.treasures.size() <= resource.data.treasures.size()
          && resource.data.treasures.hasAll(request.resource.data.treasures)
          && request.resource.data.scores is map
          && request.resource.data.moves == resource.data.moves + 1
          && request.resource.data.turn is string
          && request.resource.data.winner is string
          && request.resource.data.status in ['playing', 'finished']
          && (
            (resource.data.members[0] == request.auth.uid
              && request.resource.data.positions[1] == resource.data.positions[1]
              && (
                request.resource.data.positions[0] == resource.data.positions[0] + 7
                || request.resource.data.positions[0] == resource.data.positions[0] - 7
                || (request.resource.data.positions[0] == resource.data.positions[0] + 1 && resource.data.positions[0] % 7 != 6)
                || (request.resource.data.positions[0] == resource.data.positions[0] - 1 && resource.data.positions[0] % 7 != 0)
              )
              && request.resource.data.scores[request.auth.uid] ==
                resource.data.scores[request.auth.uid] + (resource.data.treasures.hasAny([request.resource.data.positions[0]]) ? 1 : 0)
              && request.resource.data.scores[resource.data.members[1]] == resource.data.scores[resource.data.members[1]])
            ||
            (resource.data.members[1] == request.auth.uid
              && request.resource.data.positions[0] == resource.data.positions[0]
              && (
                request.resource.data.positions[1] == resource.data.positions[1] + 7
                || request.resource.data.positions[1] == resource.data.positions[1] - 7
                || (request.resource.data.positions[1] == resource.data.positions[1] + 1 && resource.data.positions[1] % 7 != 6)
                || (request.resource.data.positions[1] == resource.data.positions[1] - 1 && resource.data.positions[1] % 7 != 0)
              )
              && request.resource.data.scores[request.auth.uid] ==
                resource.data.scores[request.auth.uid] + (resource.data.treasures.hasAny([request.resource.data.positions[1]]) ? 1 : 0)
              && request.resource.data.scores[resource.data.members[0]] == resource.data.scores[resource.data.members[0]])
          )
          && (
            (resource.data.treasures.hasAny([request.resource.data.positions[resource.data.members[0] == request.auth.uid ? 0 : 1]])
              && request.resource.data.treasures.size() == resource.data.treasures.size() - 1)
            ||
            (!resource.data.treasures.hasAny([request.resource.data.positions[resource.data.members[0] == request.auth.uid ? 0 : 1]])
              && request.resource.data.treasures == resource.data.treasures)
          )
          && (
            (request.resource.data.status == 'playing'
              && request.resource.data.turn == (resource.data.members[0] == request.auth.uid ? resource.data.members[1] : resource.data.members[0])
              && request.resource.data.treasures.size() > 0
              && request.resource.data.moves < 36)
            ||
            (request.resource.data.status == 'finished'
              && request.resource.data.turn == ''
              && (request.resource.data.treasures.size() == 0 || request.resource.data.moves >= 36)
              && (request.resource.data.winner == '' || request.resource.data.winner in resource.data.members))
          ))
        ||
        // Football quiz players submit answers and host advances rounds.
        (resource.data.game == 'football_quiz'
          && request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['answers', 'scores', 'round', 'status', 'updatedAt'])
          && request.resource.data.answers is map
          && request.resource.data.scores is map
          && request.resource.data.round is int
          && request.resource.data.status in ['waiting', 'playing', 'finished'])
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.hostId;
      match /chat/{messageId} {
        function isGameMember() {
          let room = get(/databases/$(database)/documents/gameRooms/$(roomId));
          return request.auth != null && room.data.members is list
            && request.auth.uid in room.data.members;
        }
        allow read: if isGameMember();
        allow create: if isGameMember() && accountNotBanned() && chatNotMuted()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 60
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update: if false;
        allow delete: if isGameMember() && resource.data.uid == request.auth.uid;
      }
    }


    // V6 interest clubs: membership changes are limited to one self-join/leave at a time.
    match /forumClubs/{clubId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 40
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 180
        && request.resource.data.category in ['الأنمي والمانغا','كرة القدم','الشعر والأدب','الألعاب','التقنية','التصوير والفن','القراءة','متنوع']
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0] == request.auth.uid
        && request.resource.data.active == true;
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.ownerId
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.members == resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description','category']))
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members is list
          && (
            (request.resource.data.members.hasAll(resource.data.members)
              && request.resource.data.members.size() == resource.data.members.size() + 1
              && request.auth.uid in request.resource.data.members
              && !(request.auth.uid in resource.data.members))
            ||
            (resource.data.members.hasAll(request.resource.data.members)
              && resource.data.members.size() == request.resource.data.members.size() + 1
              && request.auth.uid in resource.data.members
              && !(request.auth.uid in request.resource.data.members))
          ))
      );
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.ownerId || isChatStaff());

      match /posts/{postId} {
        function clubMembers() {
          return get(/databases/$(database)/documents/forumClubs/$(clubId)).data.members;
        }
        allow read: if request.auth != null && request.auth.uid in clubMembers();
        allow create: if request.auth != null && accountNotBanned()
          && request.auth.uid in clubMembers()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 60
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update: if false;
        allow delete: if request.auth != null
          && (resource.data.authorId == request.auth.uid || isChatStaff());
      }
    }

    match /forumThanks/{thanksId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 400;
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isChatStaff());
    }

    // Future Arcade: private rooms, member-only chat, tournaments and profiles.
    match /arcadeRooms/{roomId} {
      function arcadeMember() {
        return request.auth != null && request.auth.uid in resource.data.members;
      }
      allow read: if request.auth != null
        && (arcadeMember() || resource.data.status == 'waiting');
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.gameId in ['arcade_ludo','arcade_jackaroo','arcade_chess','arcade_mafia','arcade_racing','arcade_snake','arcade_space','arcade_platform','arcade_tower','arcade_fishing','arcade_millionaire','arcade_sudoku','arcade_wordsearch','arcade_bomb','arcade_duel_hub','arcade_friend_world']
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0] == request.auth.uid
        && request.resource.data.roomCode is string
        && request.resource.data.roomCode.matches('^[0-9]{6}$')
        && request.resource.data.status == 'waiting'
        && request.resource.data.visibility == 'private';
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.hostId
          && request.resource.data.hostId == resource.data.hostId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','status','updatedAt'])
          && request.resource.data.members is list
          && request.resource.data.members.size() <= 4
          && request.resource.data.members.hasAll(resource.data.members))
        ||
        (!(request.auth.uid in resource.data.members)
          && resource.data.status == 'waiting'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','memberNames','status','updatedAt'])
          && request.resource.data.members is list
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.memberNames[request.auth.uid] is string
          && request.resource.data.memberNames[request.auth.uid].size() <= 60
          && request.resource.data.status == 'waiting')
        ||
        (arcadeMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','updatedAt'])
          && request.resource.data.state is map)
      );
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.hostId || isChatStaff());
      match /chat/{messageId} {
        function parentArcadeMember() {
          return request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/arcadeRooms/$(roomId)).data.members;
        }
        allow read: if parentArcadeMember();
        allow create: if parentArcadeMember() && accountNotBanned() && chatNotMuted()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
    }

    match /arcadeTournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 60
        && request.resource.data.gameId in ['arcade_ludo','arcade_jackaroo','arcade_chess','arcade_mafia','arcade_racing','arcade_snake','arcade_space','arcade_platform','arcade_tower','arcade_fishing','arcade_millionaire','arcade_sudoku','arcade_wordsearch','arcade_bomb']
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 1
        && request.resource.data.participants[0] == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.creatorId
          && request.resource.data.creatorId == resource.data.creatorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants','status','updatedAt'])
          && request.resource.data.participants is list
          && request.resource.data.participants.size() <= 16
          && request.resource.data.participants.hasAll(resource.data.participants))
        ||
        (!(request.auth.uid in resource.data.participants)
          && resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants','updatedAt'])
          && request.resource.data.participants.size() == resource.data.participants.size() + 1
          && request.resource.data.participants.hasAll(resource.data.participants)
          && request.auth.uid in request.resource.data.participants)
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }

    match /arcadeProfiles/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName','photoUrl','equippedBadge','equippedFrame','createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.photoUrl is string
        && request.resource.data.equippedBadge is string
        && request.resource.data.equippedFrame is string;
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoUrl','equippedBadge','equippedFrame']);
      allow delete: if false;
    }


    // V12 community tournaments: authenticated members can create and join;
    // only the organizer can close registration. Player entries are self-owned.
    match /communityTournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && accountNotBanned()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 500
        && request.resource.data.game == 'تحديات عامة'
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.startsAt is timestamp;
      allow update: if request.auth != null
        && resource.data.createdBy == request.auth.uid
        && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'roundOne'])
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.status == 'closed')
          || (request.resource.data.status == 'open'
            && !('roundOne' in resource.data)
            && request.resource.data.roundOne is list
            && request.resource.data.roundOne.size() > 0
            && request.resource.data.roundOne.size() <= 16)
        );
      allow delete: if request.auth != null
        && (resource.data.createdBy == request.auth.uid || isFounder());

      match /players/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && accountNotBanned()
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.joinedAt == request.time
          && get(/databases/$(database)/documents/communityTournaments/$(tournamentId)).data.status == 'open';
        allow update: if false;
        allow delete: if request.auth != null
          && request.auth.uid == userId
          && get(/databases/$(database)/documents/communityTournaments/$(tournamentId)).data.status == 'open';
      }
    }


    // V25 coin wallets: only the founder can mint/grant coins; members may only spend.
    match /coinWallets/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isFounder());
      allow create: if isFounder()
        && request.resource.data.keys().hasOnly(['coins', 'updatedAt', 'grantedBy'])
        && request.resource.data.coins is int
        && request.resource.data.coins >= 0
        && request.resource.data.updatedAt == request.time
        && request.resource.data.grantedBy == request.auth.uid;
      // Preserve legacy wallet metadata while allowing the founder to update
      // only the balance/audit fields used by the store's gift transaction.
      allow update: if (
          isFounder()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'updatedAt', 'grantedBy'])
          && request.resource.data.coins is int
          && request.resource.data.coins >= 0
          && request.resource.data.updatedAt == request.time
          && request.resource.data.grantedBy == request.auth.uid
        ) || (
          request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'updatedAt'])
          && request.resource.data.coins is int
          && request.resource.data.coins >= 0
          && request.resource.data.coins <= resource.data.coins
          && request.resource.data.updatedAt == request.time
        );
      allow delete: if false;
    }

    // Top-up is a review request only. No payment is processed by the app.
    match /coinTopupRequests/{requestId} {
      allow create: if request.auth != null
        && accountNotBanned()
        && request.resource.data.keys().hasOnly(['uid', 'amount', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.amount is int
        && request.resource.data.amount in [100, 250, 500, 1000]
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isFounder());
      allow update: if isFounder()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    match /developerLinks/{documentId} {
      allow read: if request.auth != null;
      allow create, update: if isFounder()
        && documentId == 'main'
        && request.resource.data.keys().hasOnly([
          'telegram', 'instagram', 'tiktok', 'youtube', 'website', 'updatedAt'
        ])
        && request.resource.data.telegram is string
        && request.resource.data.telegram.size() <= 2048
        && request.resource.data.instagram is string
        && request.resource.data.instagram.size() <= 2048
        && request.resource.data.tiktok is string
        && request.resource.data.tiktok.size() <= 2048
        && request.resource.data.youtube is string
        && request.resource.data.youtube.size() <= 2048
        && request.resource.data.website is string
        && request.resource.data.website.size() <= 2048
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /chatControls/{documentId} {
      allow read: if request.auth != null;
      allow create, update: if isFounder()
        && documentId == 'main'
        && request.resource.data.keys().hasOnly([
          'allowLinks', 'allowMedia', 'directMessagesEnabled',
          'publicChatEnabled', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.allowLinks is bool
        && request.resource.data.allowMedia is bool
        && request.resource.data.directMessagesEnabled is bool
        && request.resource.data.publicChatEnabled is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // Shared IPTV libraries: signed-in members can read; only the founder can publish or edit.
    match /iptvSharedPlaylists/{playlistId} {
      // Every active signed-in member can read the shared library; banned accounts cannot.
      allow read: if request.auth != null && accountNotBanned();
      allow create: if isFounder() && accountNotBanned()
        && request.resource.data.keys().hasOnly(['name','sourceUrl','ownerUid','channelCount','updatedBy','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.sourceUrl is string && request.resource.data.sourceUrl.size() <= 2048
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.channelCount is int && request.resource.data.channelCount > 0 && request.resource.data.channelCount <= 10000
        && request.resource.data.updatedAt == request.time;
      allow update: if isFounder() && accountNotBanned()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','sourceUrl','channelCount','updatedBy','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.sourceUrl is string && request.resource.data.sourceUrl.size() <= 2048
        && request.resource.data.channelCount is int && request.resource.data.channelCount > 0 && request.resource.data.channelCount <= 10000
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if isFounder() && accountNotBanned();
      match /channels/{channelId} {
        allow read: if request.auth != null && accountNotBanned();
        allow create, update: if isFounder() && accountNotBanned()
          && exists(/databases/$(database)/documents/iptvSharedPlaylists/$(playlistId))
          && request.resource.data.keys().hasOnly(['index','name','url','group','logo','tvgId','source','sourceUrl'])
          && request.resource.data.index is int && request.resource.data.index >= 0
          && request.resource.data.index < get(/databases/$(database)/documents/iptvSharedPlaylists/$(playlistId)).data.channelCount
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
          && request.resource.data.url is string && request.resource.data.url.size() <= 4096 && request.resource.data.url.matches('https?://.*')
          && request.resource.data.group is string && request.resource.data.group.size() <= 100
          && request.resource.data.logo is string && request.resource.data.logo.size() <= 2048
          && request.resource.data.tvgId is string && request.resource.data.tvgId.size() <= 160
          && request.resource.data.source is string && request.resource.data.source.size() <= 100
          && request.resource.data.sourceUrl is string
          && request.resource.data.sourceUrl == get(/databases/$(database)/documents/iptvSharedPlaylists/$(playlistId)).data.sourceUrl;
        allow delete: if isFounder() && accountNotBanned();
      }
    }
    // V26 gaming guide, local game library notes and wallpaper favourites use
    // SharedPreferences. They do not create Firestore records, so no permissive
    // client-writable cloud collection is added until a synced schema is designed.

  }
}
