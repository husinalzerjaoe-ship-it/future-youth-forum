rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isFounder() {
      return request.auth != null
        && request.auth.token.email == 'husinalzerjaoe@gmail.com';
    }
    function isChatStaff() {
      return request.auth != null && (isFounder()
        || exists(/databases/$(database)/documents/chatModerators/$(request.auth.uid)));
    }
    function accountNotBanned() {
      let path = /databases/$(database)/documents/userSanctions/$(request.auth.uid);
      return !exists(path)
        || (get(path).data.permanentBan != true
          && (!('banUntil' in get(path).data) || get(path).data.banUntil <= request.time));
    }
    function chatNotMuted() {
      let path = /databases/$(database)/documents/userSanctions/$(request.auth.uid);
      return !exists(path)
        || (get(path).data.permanentMute != true
          && (!('muteUntil' in get(path).data) || get(path).data.muteUntil <= request.time));
    }
    function usersNotBlocked(a, b) {
      return !exists(/databases/$(database)/documents/userBlocks/$(a + '_' + b))
        && !exists(/databases/$(database)/documents/userBlocks/$(b + '_' + a));
    }
    function roomNotBanned(roomId) {
      return !exists(/databases/$(database)/documents/regionalChats/$(roomId)/bans/$(request.auth.uid))
        || (get(/databases/$(database)/documents/regionalChats/$(roomId)/bans/$(request.auth.uid)).data.permanent != true
          && get(/databases/$(database)/documents/regionalChats/$(roomId)/bans/$(request.auth.uid)).data.expiresAt < request.time);
    }
    // Private account data, including email, is visible only to its owner.
    match /users/{userId} {
      allow create, read, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if false;

      match /animeWatchlist/{entryId} {
        allow read, create, delete: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['planned', 'watching', 'watched'];
      }
    }

    match /animeWallpapers/{wallpaperId} {
      allow read: if request.auth != null
        && (resource.data.status == 'approved'
          || resource.data.uploaderId == request.auth.uid
          || isFounder());
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.uploaderId == request.auth.uid
        && (
          (request.resource.data.get('category', '') == 'music'
            && request.resource.data.status == 'approved'
            && request.resource.data.extension in ['mp3','m4a','aac','wav','ogg','flac'])
          || (request.resource.data.get('category', '') != 'music'
            && request.resource.data.status == 'pending')
        )
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.anime is string
        && request.resource.data.anime.size() <= 80
        && request.resource.data.artist is string
        && request.resource.data.artist.size() > 0
        && request.resource.data.artist.size() <= 100
        && (!('sourceUrl' in request.resource.data)
          || request.resource.data.sourceUrl == ''
          || (request.resource.data.sourceUrl is string
            && request.resource.data.sourceUrl.matches('https://.*')))
        && request.resource.data.rights in [
          'أنا صاحب العمل وأسمح بنشره',
          'ترخيص Creative Commons يسمح بإعادة الاستخدام',
          'إذن مكتوب من صاحب الحقوق',
          'مصدر رسمي يسمح صراحة بإعادة الاستخدام'
        ]
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.matches('https://.*');
      allow update: if isFounder()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if isFounder()
        || (request.auth != null && resource.data.uploaderId == request.auth.uid && resource.data.status == 'pending');
    }

    // Public profile fields only: display name, biography and photo URL.

    match /users/{userId}/savedPosts/{postId} {
      allow read, create, delete: if request.auth != null
        && request.auth.uid == userId;
      allow update: if false;
    }

    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'bio', 'photoUrl', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() <= 2048;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'photoUrl'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() <= 2048;
      allow delete: if false;

      match /followers/{followerId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == followerId;
        allow delete: if request.auth != null && request.auth.uid == followerId;
        allow update: if false;
      }

      match /following/{followedId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == userId
          && followedId != userId
          && request.resource.data.userId == followedId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }

      match /ratings/{raterId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == raterId
          && raterId != userId
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1
          && request.resource.data.stars <= 5;
        allow delete: if false;
      }
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000;
      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'videoUrl']);
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isFounder());

      match /likes/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && accountNotBanned()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update: if request.auth != null
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']);
        allow delete: if request.auth != null
          && resource.data.authorId == request.auth.uid;
      }
    }

    match /watchRooms/{roomId} {
      function canAccessRoom() {
        return request.auth != null && (
          resource.data.visibility != 'private'
          || resource.data.hostUid == request.auth.uid
          || (resource.data.invitedUids is list && request.auth.uid in resource.data.invitedUids)
        );
      }
      allow read: if canAccessRoom();
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.url is string
        && request.resource.data.sourceType in ['youtube', 'direct']
        && request.resource.data.status == 'paused'
        && request.resource.data.active == true
        && request.resource.data.visibility in ['public', 'private']
        && request.resource.data.invitedUids is list
        && request.resource.data.invitedUids.size() <= 50
        && (request.resource.data.visibility != 'private' || request.auth.uid in request.resource.data.invitedUids || request.resource.data.invitedUids.size() == 0);
      allow update: if request.auth != null
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'positionSeconds', 'updatedAt', 'active']);
      allow delete: if request.auth != null && (resource.data.hostUid == request.auth.uid || isFounder());
      match /participants/{userId} {
        allow read: if canAccessRoom();
        allow create, update: if canAccessRoom() && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 60
          && request.resource.data.photoUrl is string;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 300
        && request.resource.data.status == 'new';
      allow read: if isChatStaff();
      allow update: if isChatStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status == 'reviewed'
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if isFounder();
    }

    // Public chat: users may edit/delete their own messages; founder/moderators can pin and moderate.
    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned() && chatNotMuted()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderRole == (isFounder() ? 'founder' : 'member')
        && request.resource.data.type in ['text', 'image', 'sticker', 'voice']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && (
          (request.resource.data.type == 'text' && request.resource.data.text.size() > 0)
          || (request.resource.data.type == 'sticker' && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 16)
          || (request.resource.data.type == 'image'
            && request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.matches('https://.*'))
          || (request.resource.data.type == 'voice'
            && request.resource.data.audioUrl is string
            && request.resource.data.audioUrl.matches('https://.*')
            && request.resource.data.durationSeconds is int
            && request.resource.data.durationSeconds >= 1
            && request.resource.data.durationSeconds <= 180)
        )
        && (!('replyTo' in request.resource.data) || request.resource.data.replyTo is map);
      allow update: if request.auth != null && (
        (resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000)
        || (isChatStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinned', 'pinnedBy'])
          && request.resource.data.pinnedBy == request.auth.uid
          && request.resource.data.isPinned is bool)
      );
      allow delete: if request.auth != null
        && (resource.data.senderId == request.auth.uid || isChatStaff());

      match /reactions/{userId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.emoji in ['❤️', '😂', '🔥', '👏'];
        allow delete: if request.auth != null
          && (request.auth.uid == userId || isChatStaff());
      }
    }

    match /chatPresence/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.online is bool;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /chatTyping/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.typing is bool;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /chatPreferences/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['background', 'updatedAt'])
        && request.resource.data.background is int;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Only the founder can grant/revoke paid or complimentary memberships.
    match /memberships/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isFounder()
        && request.resource.data.uid == userId
        && request.resource.data.tier in ['premium', 'silver', 'gold', 'diamond']
        && request.resource.data.expiresAt is timestamp;
      allow delete: if isFounder();
    }

    match /chatModerators/{userId} {
      allow read: if isFounder() || (request.auth != null && request.auth.uid == userId);
      allow create, update: if isFounder()
        && request.resource.data.uid == userId
        && request.resource.data.grantedBy == request.auth.uid;
      allow delete: if isFounder();
    }

    // Central moderation records. Only the founder or assigned moderators can change sanctions.
    match /userSanctions/{userId} {
      allow read: if isChatStaff() || (request.auth != null && request.auth.uid == userId);
      allow create, update: if isChatStaff()
        && request.resource.data.uid == userId
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isFounder();
    }

    // Append-only audit trail; client cannot edit or erase historical actions.
    match /adminLogs/{logId} {
      allow read: if isChatStaff();
      allow create: if isChatStaff()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.action is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /weeklyContests/{contestId} {
      allow read: if request.auth != null;
      allow create: if isFounder()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.status == 'open'
        && request.resource.data.endsAt is timestamp;
      allow update: if isFounder()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'winnerUid', 'winnerChosenAt']);
      allow delete: if isFounder();

      match /entries/{userId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isFounder());
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && get(/databases/$(database)/documents/weeklyContests/$(contestId)).data.status == 'open'
          && get(/databases/$(database)/documents/weeklyContests/$(contestId)).data.endsAt > request.time;
        allow update: if false;
        allow delete: if request.auth != null && (request.auth.uid == userId || isFounder());
      }
    }

    match /poems/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 3000;
      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']);
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    match /quotes/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 3000;
      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']);
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    match /mediaLinks/{linkId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.url is string
        && request.resource.data.url.matches('https://(www\\.|m\\.|music\\.)?youtube\\.com/.*|https://(www\\.)?youtu\\.be/.*|https://(www\\.)?youtube-nocookie\\.com/.*')
        && request.resource.data.category in ['أغاني', 'فيديوهات', 'أفلام ومقاطع رسمية', 'تعليم', 'متنوع'];
      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'url', 'category'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.url is string
        && request.resource.data.url.matches('https://(www\\.|m\\.)?youtube\\.com/.*|https://(www\\.)?youtu\\.be/.*')
        && request.resource.data.category in ['أغاني', 'فيديوهات', 'أفلام ومقاطع رسمية', 'تعليم', 'متنوع'];
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.matches('https://.*')
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h');
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;

      match /views/{viewerId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == viewerId
          && request.resource.data.viewerId == request.auth.uid;
        allow delete: if request.auth != null && request.auth.uid == viewerId;
      }

      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && accountNotBanned()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300;
        allow update: if request.auth != null
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']);
        allow delete: if request.auth != null
          && (resource.data.authorId == request.auth.uid || isChatStaff());
      }
    }

    match /regionalChats/{roomId}/bans/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isFounder());
      allow create, update: if isFounder()
        && request.resource.data.permanent is bool
        && request.resource.data.by == request.auth.uid
        && (request.resource.data.permanent == true
          ? request.resource.data.expiresAt == null
          : request.resource.data.expiresAt is timestamp);
      allow delete: if isFounder();
    }

    match /regionalChats/{roomId}/messages/{messageId} {
      allow read: if request.auth != null && roomNotBanned(roomId);
      allow create: if request.auth != null && accountNotBanned() && chatNotMuted() && roomNotBanned(roomId)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderRole == (isFounder() ? 'founder' : 'member')
        && request.resource.data.type in ['text', 'image', 'sticker', 'voice']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && (
          (request.resource.data.type == 'text' && request.resource.data.text.size() > 0)
          || (request.resource.data.type == 'sticker' && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 16)
          || (request.resource.data.type == 'image'
            && request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.matches('https://.*'))
          || (request.resource.data.type == 'voice'
            && request.resource.data.audioUrl is string
            && request.resource.data.audioUrl.matches('https://.*')
            && request.resource.data.durationSeconds is int
            && request.resource.data.durationSeconds >= 1
            && request.resource.data.durationSeconds <= 180)
        );
      allow update, delete: if isFounder();
    }

    match /userBlocks/{blockId} {
      // A user may check their own deterministic block document even when it does not exist yet.
      allow get: if request.auth != null
        && (resource == null || resource.data.blockerId == request.auth.uid);
      allow list: if request.auth != null
        && resource.data.blockerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId is string
        && request.resource.data.blockedId != request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.blockedId;
      allow delete: if request.auth != null && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    match /conversations/{conversationId} {
      // The array-contains query in the app already targets conversations
      // containing the signed-in user. Do not require members.size() here:
      // Firestore rules are not filters and cannot prove an array's size from
      // that query, which otherwise makes the entire inbox query fail.
      allow read: if request.auth != null
        && resource.data.members is list
        && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] is string
        && request.resource.data.members[1] is string
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && usersNotBlocked(request.resource.data.members[0], request.resource.data.members[1]);
      allow update: if request.auth != null && accountNotBanned() && chatNotMuted()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt', 'memberNames', 'backgrounds'])
        && (!('backgrounds' in request.resource.data) || request.resource.data.backgrounds is map)
        && usersNotBlocked(resource.data.members[0], resource.data.members[1]);
      allow delete: if false;

      match /messages/{messageId} {
        function isMember() {
          let parent = get(/databases/$(database)/documents/conversations/$(conversationId));
          return parent.data.members is list
            && request.auth.uid in parent.data.members;
        }
        function members() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        }
        allow read: if request.auth != null && isMember();
        allow create: if request.auth != null && accountNotBanned() && chatNotMuted()
          && isMember()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole == (isFounder() ? 'founder' : 'member')
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && (
            (request.resource.data.type == 'text' && request.resource.data.text.size() > 0)
            || (request.resource.data.type == 'image'
              && request.resource.data.imageUrl is string
              && request.resource.data.imageUrl.matches('https://.*'))
            || (request.resource.data.type == 'voice'
              && request.resource.data.audioUrl is string
              && request.resource.data.audioUrl.matches('https://.*')
              && request.resource.data.durationSeconds is int
              && request.resource.data.durationSeconds >= 1
              && request.resource.data.durationSeconds <= 180)
          )
          && usersNotBlocked(members()[0], members()[1]);
        allow update: if false;
        allow delete: if false;

        match /reactions/{userId} {
          allow read: if request.auth != null && request.auth.uid in members();
          allow create, update: if request.auth != null
            && request.auth.uid == userId
            && request.auth.uid in members()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.emoji in ['❤️', '😂', '🔥', '👏', '😍', '😢']
            && usersNotBlocked(members()[0], members()[1]);
          allow delete: if request.auth != null
            && request.auth.uid == userId
            && request.auth.uid in members();
        }
      }
    }

    // Forum announcements are readable by signed-in members and writable only by the founder.
    match /forumAnnouncements/{announcementId} {
      allow read: if request.auth != null;
      allow create: if isFounder()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.author == 'Alfredo';
      allow update: if isFounder()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body']);
      allow delete: if isFounder();
    }

    match /gameInvites/{inviteId} {
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.game in ['general', 'football', 'player', 'speed'];
      allow read: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow update: if request.auth != null
        && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /notifications/{notificationId} {
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId.size() > 0
        && request.resource.data.recipientId != request.auth.uid
        && exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.recipientId))
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() <= 60
        && request.resource.data.type in ['follow', 'like', 'comment', 'message', 'story_reply', 'mention']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 180
        && request.resource.data.read == false;
      allow read: if request.auth != null && resource.data.recipientId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if false;
    }
    // Community polls: one immutable vote per signed-in member.
    match /communityPolls/{pollId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.question is string
        && request.resource.data.question.size() >= 5
        && request.resource.data.question.size() <= 160
        && request.resource.data.options is list
        && request.resource.data.options.size() >= 2
        && request.resource.data.options.size() <= 5
        && request.resource.data.options[0] is string
        && request.resource.data.options[1] is string
        && (request.resource.data.options.size() < 3 || request.resource.data.options[2] is string)
        && (request.resource.data.options.size() < 4 || request.resource.data.options[3] is string)
        && (request.resource.data.options.size() < 5 || request.resource.data.options[4] is string)
        && request.resource.data.active == true;
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.createdBy == request.auth.uid || isChatStaff());

      match /votes/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && accountNotBanned()
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.option is int
          && request.resource.data.option >= 0
          && request.resource.data.option < get(/databases/$(database)/documents/communityPolls/$(pollId)).data.options.size()
          && get(/databases/$(database)/documents/communityPolls/$(pollId)).data.active == true;
        allow update: if false;
        allow delete: if request.auth != null
          && (request.auth.uid == userId
            || isChatStaff()
            || get(/databases/$(database)/documents/communityPolls/$(pollId)).data.createdBy == request.auth.uid);
      }
    }

    // Founder-managed community events with member RSVP records.
    // Community events: preserve founder-managed RSVP subcollection and member-created attendee-list events.
    match /communityEvents/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned() && (
        (isFounder()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 100
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.description.size() <= 700
          && request.resource.data.startsAt is timestamp
          && request.resource.data.startsAt > request.time)
        ||
        (request.resource.data.createdBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 80
          && request.resource.data.details is string
          && request.resource.data.details.size() <= 500
          && request.resource.data.startsAt is timestamp
          && request.resource.data.attendees is list
          && request.resource.data.attendees.size() == 1
          && request.auth.uid in request.resource.data.attendees)
      );
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees'])
        && request.resource.data.attendees is list
        && request.resource.data.attendees.size() <= 500
        && (
          (!(request.auth.uid in resource.data.attendees)
            && request.auth.uid in request.resource.data.attendees
            && request.resource.data.attendees.hasAll(resource.data.attendees)
            && request.resource.data.attendees.size() == resource.data.attendees.size() + 1)
          || (request.auth.uid in resource.data.attendees
            && !(request.auth.uid in request.resource.data.attendees)
            && resource.data.attendees.hasAll(request.resource.data.attendees)
            && resource.data.attendees.size() == request.resource.data.attendees.size() + 1)
        );
      allow delete: if request.auth != null
        && (resource.data.createdBy == request.auth.uid || isFounder());

      match /attendees/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && accountNotBanned()
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 60
          && get(/databases/$(database)/documents/communityEvents/$(eventId)).data.startsAt > request.time;
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    } 

    // Invite-only rooms: only the owner and explicitly invited member UIDs can read.
    match /privateRooms/{roomId}/access/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId
        && request.auth.uid in get(/databases/$(database)/documents/privateRooms/$(roomId)).data.members;
      // Legacy access records are retained for compatibility; invited membership is sufficient.
      allow create, update, delete: if false;
    }

    match /privateRooms/{roomId} {
      allow read: if request.auth != null
        && resource.data.members is list
        && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 60
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 1
        && request.resource.data.members.size() <= 30
        && request.auth.uid in request.resource.data.members
        && request.resource.data.invitedUids == request.resource.data.members
        && (!('roomType' in request.resource.data)
          || request.resource.data.roomType in ['text', 'voice'])
        && (!('roomType' in request.resource.data)
          || request.resource.data.roomType != 'voice'
          || (request.resource.data.meetUrl is string
            && request.resource.data.meetUrl.matches('https://meet\\.google\\.com/.*')));
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt'])
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() <= 200)
          ||
          (request.auth.uid == resource.data.ownerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','invitedUids','roomAdmins'])
            && request.resource.data.members is list
            && request.resource.data.members.size() >= 1
            && request.resource.data.members.size() <= 30
            && request.auth.uid in request.resource.data.members
            && request.resource.data.invitedUids == request.resource.data.members
            && request.resource.data.roomAdmins is list
            && request.resource.data.members.hasAll(request.resource.data.roomAdmins))
        );
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      match /messages/{messageId} {
        function roomMembers() {
          return get(/databases/$(database)/documents/privateRooms/$(roomId)).data.members;
        }
        allow read: if request.auth != null && request.auth.uid in roomMembers();
        allow create: if request.auth != null && accountNotBanned()
          && request.auth.uid in roomMembers()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (
            (request.resource.data.type == 'text' && request.resource.data.text.size() > 0)
            || (request.resource.data.type == 'image'
              && request.resource.data.imageUrl is string
              && request.resource.data.imageUrl.matches('https://.*'))
            || (request.resource.data.type == 'voice'
              && request.resource.data.audioUrl is string
              && request.resource.data.audioUrl.matches('https://.*')
              && request.resource.data.durationSeconds is int
              && request.resource.data.durationSeconds >= 1
              && request.resource.data.durationSeconds <= 180)
          );
        allow update: if false;
        allow delete: if request.auth != null
          && request.auth.uid in roomMembers()
          && (request.auth.uid == get(/databases/$(database)/documents/privateRooms/$(roomId)).data.ownerId
            || resource.data.senderId == request.auth.uid);
      }
    }

    // Files uploaded by members stay private to the uploader until moderation.
    match /sharedFiles/{fileId} {
      allow read: if request.auth != null
        && (resource.data.status == 'approved'
          || resource.data.uploaderId == request.auth.uid
          || isFounder());
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.uploaderId == request.auth.uid
        && (
          (request.resource.data.get('category', '') == 'music'
            && request.resource.data.status == 'approved'
            && request.resource.data.extension in ['mp3','m4a','aac','wav','ogg','flac'])
          || (request.resource.data.get('category', '') != 'music'
            && request.resource.data.status == 'pending')
        )
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.extension in ['apk','xapk','zip','pdf','mp3','m4a','aac','wav','ogg','flac']
        && request.resource.data.fileUrl is string
        && request.resource.data.fileUrl.matches('https://.*')
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 104857600;
      allow update: if isFounder()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if isFounder()
        || (request.auth != null && resource.data.uploaderId == request.auth.uid && resource.data.status == 'pending');
    }



    // Community topics and threaded replies.
    match /communityTopics/{topicId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.category in ['أنمي', 'مانغا', 'ألعاب', 'نقاش عام', 'نظريات وتحليلات']
        && request.resource.data.isLocked == false
        && request.resource.data.replyCount == 0;
      allow update: if request.auth != null && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
          && request.resource.data.replyCount == resource.data.replyCount + 1)
        || (isFounder()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isLocked'])
          && request.resource.data.isLocked is bool)
      );
      allow delete: if isFounder()
        || (request.auth != null && resource.data.authorId == request.auth.uid);
      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && accountNotBanned()
          && get(/databases/$(database)/documents/communityTopics/$(topicId)).data.isLocked == false
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 60
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update: if false;
        allow delete: if request.auth != null
          && (isFounder() || resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/communityTopics/$(topicId)).data.authorId == request.auth.uid);
      }
    }

    // Watch parties: video is opened at the rights holder; chat stays in this app.
    match /watchParties/{partyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 60
        && request.resource.data.match is string
        && request.resource.data.match.size() <= 100
        && request.resource.data.streamUrl is string
        && request.resource.data.streamUrl.matches('https://.*')
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.auth.uid in request.resource.data.members
        && request.resource.data.status == 'open';
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.hostId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','match','streamUrl','status'])
          && request.resource.data.streamUrl is string
          && request.resource.data.streamUrl.matches('https://.*'))
        || (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playbackPlaying','playbackPositionMs','playbackUpdatedAt','playbackUpdatedBy'])
          && request.resource.data.playbackPlaying is bool
          && request.resource.data.playbackPositionMs is int
          && request.resource.data.playbackPositionMs >= 0
          && request.resource.data.playbackPositionMs <= 86400000
          && request.resource.data.playbackUpdatedBy == request.auth.uid)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members is list
          && request.resource.data.members.size() <= 30
          && request.auth.uid in request.resource.data.members
          && (
            (request.auth.uid == resource.data.hostId)
            || (!(request.auth.uid in resource.data.members)
              && request.resource.data.members.hasAll(resource.data.members)
              && request.resource.data.members.size() == resource.data.members.size() + 1)
            || (request.auth.uid in resource.data.members
              && resource.data.members.hasAll(request.resource.data.members)
              && resource.data.members.size() == request.resource.data.members.size() + 1
              && !(request.auth.uid in request.resource.data.members))
          ))
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.hostId;
      match /messages/{messageId} {
        function partyMembers() {
          return get(/databases/$(database)/documents/watchParties/$(partyId)).data.members;
        }
        allow read: if request.auth != null && request.auth.uid in partyMembers();
        allow create: if request.auth != null && accountNotBanned()
          && request.auth.uid in partyMembers()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 60;
        allow update, delete: if false;
      }
    }



    match /communityQuestions/{questionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.anonymous == true
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 700;
      allow update: if false;
      allow delete: if isChatStaff();
    }

    match /interestPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 60
        && request.resource.data.category in ['الأنمي والمانغا','كرة القدم','الشعر والأدب','الألعاب','التقنية','التصوير والفن']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isChatStaff());
    }


    // Realtime multiplayer game rooms. Only room members can read active games.
    match /gameRooms/{roomId} {
      allow read: if request.auth != null
        && (resource.data.status == 'waiting'
          || request.auth.uid in resource.data.members);
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0] == request.auth.uid
        && request.resource.data.status == 'waiting'
        && (
          (request.resource.data.game == 'xo'
            && request.resource.data.board is list
            && request.resource.data.board.size() == 9
            && request.resource.data.turn == request.auth.uid
            && request.resource.data.winner == '')
          ||
          (request.resource.data.game == 'football_quiz'
            && request.resource.data.round == 0
            && request.resource.data.answers is map
            && request.resource.data.scores is map)
        );
      allow update: if request.auth != null && (
        // Add a player to a waiting XO or football quiz room.
        (!(request.auth.uid in resource.data.members)
          && resource.data.status == 'waiting'
          && (
            (resource.data.game == 'xo' && resource.data.members.size() == 1
              && request.resource.data.members.size() == 2)
            ||
            (resource.data.game == 'football_quiz' && resource.data.members.size() < 4
              && request.resource.data.members.size() == resource.data.members.size() + 1)
          )
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members', 'memberNames', 'scores', 'status', 'updatedAt'])
          && ((resource.data.game == 'xo' && request.resource.data.status == 'playing')
            || (resource.data.game == 'football_quiz' && request.resource.data.status == 'waiting'))
        )
        ||
        // XO moves are synchronized between the two players.
        (resource.data.game == 'xo'
          && request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['board', 'winner', 'turn', 'status', 'updatedAt'])
          && request.resource.data.board is list
          && request.resource.data.board.size() == 9
          && request.resource.data.status in ['playing', 'finished', 'waiting']
          && request.resource.data.winner is string
          && request.resource.data.turn is string)
        ||
        // Football quiz players submit answers and host advances rounds.
        (resource.data.game == 'football_quiz'
          && request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['answers', 'scores', 'round', 'status', 'updatedAt'])
          && request.resource.data.answers is map
          && request.resource.data.scores is map
          && request.resource.data.round is int
          && request.resource.data.status in ['waiting', 'playing', 'finished'])
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.hostId;
    }

  }
}