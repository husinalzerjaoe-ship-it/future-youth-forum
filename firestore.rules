rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isFounder() {
      return request.auth != null
        && request.auth.token.email == 'husinalzerjaoe@gmail.com';
    }
    function isChatStaff() {
      return request.auth != null && (isFounder()
        || exists(/databases/$(database)/documents/chatModerators/$(request.auth.uid)));
    }
    function accountNotBanned() {
      let path = /databases/$(database)/documents/userSanctions/$(request.auth.uid);
      return !exists(path)
        || (get(path).data.permanentBan != true
          && (!('banUntil' in get(path).data) || get(path).data.banUntil <= request.time));
    }
    function chatNotMuted() {
      let path = /databases/$(database)/documents/userSanctions/$(request.auth.uid);
      return !exists(path)
        || (get(path).data.permanentMute != true
          && (!('muteUntil' in get(path).data) || get(path).data.muteUntil <= request.time));
    }
    function usersNotBlocked(a, b) {
      return !exists(/databases/$(database)/documents/userBlocks/$(a + '_' + b))
        && !exists(/databases/$(database)/documents/userBlocks/$(b + '_' + a));
    }
    function roomNotBanned(roomId) {
      return !exists(/databases/$(database)/documents/regionalChats/$(roomId)/bans/$(request.auth.uid))
        || (get(/databases/$(database)/documents/regionalChats/$(roomId)/bans/$(request.auth.uid)).data.permanent != true
          && get(/databases/$(database)/documents/regionalChats/$(roomId)/bans/$(request.auth.uid)).data.expiresAt < request.time);
    }
    // Private account data, including email, is visible only to its owner.
    match /users/{userId} {
      allow create, read, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if false;
    }

    // Public profile fields only: display name, biography and photo URL.

    match /users/{userId}/savedPosts/{postId} {
      allow read, create, delete: if request.auth != null
        && request.auth.uid == userId;
      allow update: if false;
    }

    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'bio', 'photoUrl', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() <= 2048;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'photoUrl'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() <= 2048;
      allow delete: if false;

      match /followers/{followerId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == followerId;
        allow delete: if request.auth != null && request.auth.uid == followerId;
        allow update: if false;
      }

      match /following/{followedId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == userId
          && followedId != userId
          && request.resource.data.userId == followedId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }

      match /ratings/{raterId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == raterId
          && raterId != userId
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1
          && request.resource.data.stars <= 5;
        allow delete: if false;
      }
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000;
      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'videoUrl']);
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;

      match /likes/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && accountNotBanned()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update: if request.auth != null
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']);
        allow delete: if request.auth != null
          && resource.data.authorId == request.auth.uid;
      }
    }

    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 300
        && request.resource.data.status == 'new';
      allow read: if isChatStaff();
      allow update: if isChatStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status == 'reviewed'
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if isFounder();
    }

    // Public chat: users may edit/delete their own messages; founder/moderators can pin and moderate.
    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned() && chatNotMuted()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderRole == (isFounder() ? 'founder' : 'member')
        && request.resource.data.type in ['text', 'image', 'sticker']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && (
          (request.resource.data.type == 'text' && request.resource.data.text.size() > 0)
          || (request.resource.data.type == 'sticker' && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 16)
          || (request.resource.data.type == 'image'
            && request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.matches('https://.*'))
        )
        && (!('replyTo' in request.resource.data) || request.resource.data.replyTo is map);
      allow update: if request.auth != null && (
        (resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000)
        || (isChatStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinned', 'pinnedBy'])
          && request.resource.data.pinnedBy == request.auth.uid
          && request.resource.data.isPinned is bool)
      );
      allow delete: if request.auth != null
        && (resource.data.senderId == request.auth.uid || isChatStaff());

      match /reactions/{userId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.emoji in ['❤️', '😂', '🔥', '👏'];
        allow delete: if request.auth != null
          && (request.auth.uid == userId || isChatStaff());
      }
    }

    match /chatPresence/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.online is bool;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /chatTyping/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.typing is bool;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /chatPreferences/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['background', 'updatedAt'])
        && request.resource.data.background is int;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Only the founder can grant/revoke paid or complimentary memberships.
    match /memberships/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isFounder());
      allow create, update: if isFounder()
        && request.resource.data.uid == userId
        && request.resource.data.tier == 'premium'
        && request.resource.data.expiresAt is timestamp;
      allow delete: if isFounder();
    }

    match /chatModerators/{userId} {
      allow read: if isFounder() || (request.auth != null && request.auth.uid == userId);
      allow create, update: if isFounder()
        && request.resource.data.uid == userId
        && request.resource.data.grantedBy == request.auth.uid;
      allow delete: if isFounder();
    }

    // Central moderation records. Only the founder or assigned moderators can change sanctions.
    match /userSanctions/{userId} {
      allow read: if isChatStaff() || (request.auth != null && request.auth.uid == userId);
      allow create, update: if isChatStaff()
        && request.resource.data.uid == userId
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isFounder();
    }

    // Append-only audit trail; client cannot edit or erase historical actions.
    match /adminLogs/{logId} {
      allow read: if isChatStaff();
      allow create: if isChatStaff()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.action is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /weeklyContests/{contestId} {
      allow read: if request.auth != null;
      allow create: if isFounder()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.status == 'open'
        && request.resource.data.endsAt is timestamp;
      allow update: if isFounder()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'winnerUid', 'winnerChosenAt']);
      allow delete: if isFounder();

      match /entries/{userId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isFounder());
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && get(/databases/$(database)/documents/weeklyContests/$(contestId)).data.status == 'open'
          && get(/databases/$(database)/documents/weeklyContests/$(contestId)).data.endsAt > request.time;
        allow update: if false;
        allow delete: if request.auth != null && (request.auth.uid == userId || isFounder());
      }
    }

    match /poems/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 3000;
      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']);
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    match /quotes/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 3000;
      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']);
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    match /mediaLinks/{linkId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.url is string
        && request.resource.data.url.matches('https://(www\\.|m\\.)?youtube\\.com/.*|https://(www\\.)?youtu\\.be/.*')
        && request.resource.data.category in ['أغاني', 'فيديوهات', 'أفلام ومقاطع رسمية', 'تعليم', 'متنوع'];
      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'url', 'category'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.url is string
        && request.resource.data.url.matches('https://(www\\.|m\\.)?youtube\\.com/.*|https://(www\\.)?youtu\\.be/.*')
        && request.resource.data.category in ['أغاني', 'فيديوهات', 'أفلام ومقاطع رسمية', 'تعليم', 'متنوع'];
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.matches('https://.*')
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h');
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;

      match /views/{viewerId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == viewerId
          && request.resource.data.viewerId == request.auth.uid;
        allow delete: if request.auth != null && request.auth.uid == viewerId;
      }

      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && accountNotBanned()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300;
        allow update: if request.auth != null
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']);
        allow delete: if request.auth != null
          && (resource.data.authorId == request.auth.uid || isChatStaff());
      }
    }

    match /regionalChats/{roomId}/bans/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isFounder());
      allow create, update: if isFounder()
        && request.resource.data.permanent is bool
        && request.resource.data.by == request.auth.uid
        && (request.resource.data.permanent == true
          ? request.resource.data.expiresAt == null
          : request.resource.data.expiresAt is timestamp);
      allow delete: if isFounder();
    }

    match /regionalChats/{roomId}/messages/{messageId} {
      allow read: if request.auth != null && roomNotBanned(roomId);
      allow create: if request.auth != null && accountNotBanned() && chatNotMuted() && roomNotBanned(roomId)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderRole == (isFounder() ? 'founder' : 'member')
        && request.resource.data.type in ['text', 'image', 'sticker']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && (
          (request.resource.data.type == 'text' && request.resource.data.text.size() > 0)
          || (request.resource.data.type == 'sticker' && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 16)
          || (request.resource.data.type == 'image'
            && request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.matches('https://.*'))
        );
      allow update, delete: if isFounder();
    }

    match /userBlocks/{blockId} {
      // A user may check their own deterministic block document even when it does not exist yet.
      allow get: if request.auth != null
        && (resource == null || resource.data.blockerId == request.auth.uid);
      allow list: if request.auth != null
        && resource.data.blockerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId is string
        && request.resource.data.blockedId != request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.blockedId;
      allow delete: if request.auth != null && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    match /conversations/{conversationId} {
      // The array-contains query in the app already targets conversations
      // containing the signed-in user. Do not require members.size() here:
      // Firestore rules are not filters and cannot prove an array's size from
      // that query, which otherwise makes the entire inbox query fail.
      allow read: if request.auth != null
        && resource.data.members is list
        && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && usersNotBlocked(request.resource.data.members[0], request.resource.data.members[1]);
      allow update: if request.auth != null && accountNotBanned()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt', 'memberNames', 'backgrounds'])
        && (!('backgrounds' in request.resource.data) || request.resource.data.backgrounds is map)
        && usersNotBlocked(resource.data.members[0], resource.data.members[1]);
      allow delete: if false;

      match /messages/{messageId} {
        function members() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        }
        allow read: if request.auth != null
          && request.auth.uid in members();
        allow create: if request.auth != null && accountNotBanned()
          && request.auth.uid in members()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole == (isFounder() ? 'founder' : 'member')
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && usersNotBlocked(members()[0], members()[1]);
        allow update, delete: if false;
      }
    }

    // Forum announcements are readable by signed-in members and writable only by the founder.
    match /forumAnnouncements/{announcementId} {
      allow read: if request.auth != null;
      allow create: if isFounder()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.author == 'Alfredo';
      allow update: if isFounder()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body']);
      allow delete: if isFounder();
    }

    match /gameInvites/{inviteId} {
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.game in ['general', 'football', 'player', 'speed'];
      allow read: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow update: if request.auth != null
        && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /notifications/{notificationId} {
      allow create: if request.auth != null && accountNotBanned()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId.size() > 0
        && request.resource.data.recipientId != request.auth.uid
        && exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.recipientId))
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() <= 60
        && request.resource.data.type in ['follow', 'like', 'comment', 'message', 'story_reply', 'mention']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 180
        && request.resource.data.read == false;
      allow read: if request.auth != null && resource.data.recipientId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if false;
    }

  }
}
